generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum ReviewAction {
  APPROVE
  REQUEST_CHANGES
}

enum TaskStatus {
  COMPLETED
  IN_PROGRESS
  BLOCKED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  reports   Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id               String          @id @default(cuid())
  userId           String
  projectId        String
  weekStartDate    DateTime
  weekEndDate      DateTime
  status           ReportStatus    @default(DRAFT)
  blockers         String?
  achievements     String?
  nextWeekPlans    String?
  isKeyIssue       Boolean         @default(false)
  isKeyAchievement Boolean         @default(false)
  project          Project         @relation(fields: [projectId], references: [id])
  tasks            ReportTask[]
  reviewHistory    ReviewHistory[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([weekStartDate])
}

model ReportTask {
  id         String       @id @default(cuid())
  reportId   String
  name       String
  priority   TaskPriority
  plannedPct Int
  actualPct  Int
  status     TaskStatus
  timeSpent  String?
  output     String?
  report     Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([reportId])
}

model ReviewHistory {
  id        String       @id @default(cuid())
  reportId  String
  managerId String
  action    ReviewAction
  comment   String?
  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([reportId])
  @@index([managerId])
}
